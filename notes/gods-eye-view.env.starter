# God's Eye View — starter env. Copy to the GEV checkout as `.env`, chmod 600.
#
#   cp notes/gods-eye-view.env.starter /path/to/gods-eye-view/.env
#   chmod 600 /path/to/gods-eye-view/.env
#
# Every key is OPTIONAL — GEV runs keyless. Prefer adding keys through the in-app
# POWER UP panel, which writes this file for you. See notes/gods-eye-view-setup.md.
# Full reference, including CCTV source tuning, is the upstream .env.example.

# --- Map -------------------------------------------------------------------
# Free tier, eligible personal/non-commercial use. The one worth getting first:
# photorealistic Google 3D through ion, plus Cesium World Terrain.
# CLIENT-EXPOSED — use an assets:read token with URL restrictions.
CESIUM_ION_TOKEN=

# Direct Google Photorealistic 3D Tiles + GEV place search. Metered/billed.
# CLIENT-EXPOSED — restrict by HTTP referrer AND API in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Separate key for SERVER-SIDE Google calls (Places, Street View CCTV fallback).
# Never reaches the browser, so restrict it by server IP instead. Unset, those
# calls fall back to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_API_KEY=

# --- Live layers -----------------------------------------------------------
# Voice control. Server-side only — do NOT prefix with VITE_.
OPENAI_API_KEY=

# Live worldwide vessels (free). Server-side only.
AISSTREAM_API_KEY=

# NASA live active fires (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Real traffic flow (free tier: 200k tiles/month). Without it the traffic layer
# runs its built-in simulation.
TOMTOM_API_KEY=

# Flights work anonymously but are rate-limited. Credentials lift that.
# Set OPENSKY_AUTH_MODE=anon to skip auth entirely.
OPENSKY_AUTH_MODE=oauth
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Server ----------------------------------------------------------------
PORT=4173

# Leave HOST unset (localhost). The server brokers your API keys, so anyone who
# can reach it can spend your quota. Only set 0.0.0.0 on a network you trust —
# and set the throttles below if you do.
# HOST=0.0.0.0

# Per-IP, per-minute caps on the endpoints that cost money. Unset = unlimited.
# In-memory guards, NOT billing caps — set provider-side budgets as well.
# GEV_RATELIMIT_GOOGLE_PER_MIN=60
# GEV_RATELIMIT_OPENAI_PER_MIN=30
